# ---------------------------------------------------------------------------
# RocksCord configuration
#
# EVERY setting here has a working default. You do NOT need this file to run
# the app locally -- `npm run setup` works with no .env at all. Copy this to
# `.env` only when you want to override something or deploy.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Interface to bind. 0.0.0.0 accepts connections from other devices on your
# LAN (needed to test from a phone); 127.0.0.1 restricts to this machine.
HOST=0.0.0.0
PORT=4000

# Absolute URL this server is reachable at. Used to build attachment links.
#
# Leave blank and it is detected automatically: Render, Railway, and Fly all publish the
# service address, and locally it falls back to http://HOST:PORT. Set it explicitly only
# for a custom domain or a reverse proxy.
PUBLIC_URL=

# --- Database --------------------------------------------------------------

# libSQL connection string.
#   blank                       -> ./data/rockscord.db  (default, zero setup)
#   file:/absolute/path.db      -> a specific local file
#   libsql://your-db.turso.io   -> hosted Turso (free tier), needs the token below
#
# Note: ":memory:" is NOT supported. This driver gives every connection its own
# private in-memory database, so transactions would run against an empty schema.
DATABASE_URL=

# Only needed when DATABASE_URL points at Turso.
#   turso db tokens create your-db
DATABASE_AUTH_TOKEN=

# --- Authentication --------------------------------------------------------

# HMAC key used to sign access tokens.
# Leave blank in development and one is generated per run (which signs everyone
# out on restart). REQUIRED in production -- the server refuses to start without it.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Access tokens are short-lived because they cannot be revoked before expiry.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh tokens are long-lived but revocable, and rotate on every use.
REFRESH_TOKEN_TTL_SECONDS=2592000

# Set true when serving over HTTPS so the refresh cookie gets Secure + SameSite=None.
# Required if the API and the web client are on different domains.
COOKIE_SECURE=false
# Only set this if you serve the API and client from different subdomains.
COOKIE_DOMAIN=

# Allowed browser origins, comma-separated, or * for any.
# Tighten this in production, e.g. https://rockscord.onrender.com
CORS_ORIGIN=*

# Set false to close registration on a public deployment.
ALLOW_REGISTRATION=true

# --- Email (account verification) ------------------------------------------
#
# OFF BY DEFAULT. Registration signs people straight in unless
# REQUIRE_EMAIL_VERIFICATION is explicitly set to true below.

# Which transport delivers verification links.
#
#   auto     -> Brevo if EMAIL_API_KEY is set, otherwise `console`   (default)
#   brevo    -> Brevo's HTTP API
#   console  -> print the link to the server log and send nothing
#
# `console` is what lets the app run with no email account anywhere: the link
# still gets generated, it just arrives in the terminal instead of an inbox.
EMAIL_DRIVER=auto

# Brevo API key (looks like `xkeysib-...`). Free tier is 300 messages/day with
# no card and no domain required.
#
# Heads up: Brevo holds NEW ACCOUNTS for manual approval, and refuses every send
# with HTTP 403 until a human agrees. A key being accepted does not mean mail
# can actually be delivered -- run `npm run test:email` to find out which.
EMAIL_API_KEY=

# The From address. Must be listed AND confirmed under Brevo's Senders page;
# Brevo emails it a link that has to be clicked.
EMAIL_FROM=
EMAIL_FROM_NAME=RocksCord

# Whether an unverified account is refused a sign-in.
#
# Leave this off until `npm run test:email` has actually put a message in an
# inbox. Turning it on while the provider is still refusing sends creates
# accounts that can never sign in and never receive the link that would fix
# them -- including yours.
#
# `true` also works with no provider at all: links go to the server log, which
# is how to exercise the whole flow locally.
REQUIRE_EMAIL_VERIFICATION=false

# How long a verification link stays valid. Default 24 hours.
EMAIL_VERIFICATION_TTL_SECONDS=86400

# --- File storage ----------------------------------------------------------

# local    -> writes to UPLOAD_DIR on disk (default; right for local + desktop)
# supabase -> Supabase Storage, needed on hosts with no persistent disk
STORAGE_DRIVER=local

# Where the local driver writes. Blank means ./data/uploads
UPLOAD_DIR=

# Only needed when STORAGE_DRIVER=supabase.
# Create a PUBLIC bucket, then take these from Project Settings -> API.
SUPABASE_URL=
# Service-role key. Server-side only -- never expose this to a browser.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=rockscord-uploads

# --- Voice (WebRTC) --------------------------------------------------------

# Voice is peer-to-peer and needs no server. Google's public STUN servers are
# used by default and cover most home networks.
#
# A TURN relay is only needed behind symmetric NAT or a corporate firewall.
# The free Open Relay project (metered.ca) gives 20 GB/month:
# TURN_URL=turn:standard.relay.metered.ca:80
# TURN_USERNAME=
# TURN_CREDENTIAL=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Misc ------------------------------------------------------------------

# Serve the built web client from the API process (single-service deployment).
SERVE_CLIENT=true

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Master switch for rate limiting. Leave on unless you are load-testing.
RATE_LIMIT_ENABLED=true
