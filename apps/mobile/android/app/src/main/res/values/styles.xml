<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The shared base, so the Android 15 variant in values-v35 can add one attribute
      without repeating everything. A qualified resource replaces its default outright
      rather than merging with it, which is the usual way these two drift apart.

      Dark, because the app is dark. Capacitor's default is
      `Theme.AppCompat.Light.DarkActionBar`, which paints a white window behind the
      WebView; that white shows on every cold start and behind the page whenever the
      WebView is mid-navigation or over-scrolled.
    -->
    <style name="RocksCordBase" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/rockscordBackground</item>

        <!--
          The system bars, painted to match the app so the inset strips do not read as
          borders. `windowLightStatusBar` false keeps the clock and icons light, which is
          what makes them legible against this background rather than black on near-black.
        -->
        <item name="android:statusBarColor">@color/rockscordBackground</item>
        <item name="android:navigationBarColor">@color/rockscordBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme" parent="RocksCordBase" />

    <style name="AppTheme.NoActionBar" parent="RocksCordBase" />

    <!--
      The launch screen.

      `windowSplashScreenBackground` is the Android 12+ path and `android:background` the
      older one; both are set because the app supports a range that spans the change, and
      a device using the path that was left out falls back to white.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/rockscordBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
