<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch screen: the app icon on the app's own background.

  Replaces Capacitor's default white splash.png, which is what a cold start would
  otherwise show for the second or two before the remote client paints.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/rockscordBackground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
